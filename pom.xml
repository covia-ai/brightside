<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>ai.covia</groupId>
	<artifactId>brightside</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Brightside</name>
	<description>Brightside — a Covia desktop companion: an embedded Covia venue with a chat window, living in the system tray.</description>
	<url>https://github.com/covia-ai/brightside</url>

	<licenses>
		<license>
			<name>Eclipse Public License - v 2.0</name>
			<url>https://www.eclipse.org/legal/epl-2.0/</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Mike Anderson</name>
			<email>mike@covia.ai</email>
			<organization>Covia</organization>
			<organizationUrl>https://covia.ai</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/covia-ai/brightside.git</connection>
		<developerConnection>scm:git:ssh://github.com:covia-ai/brightside.git</developerConnection>
		<url>https://github.com/covia-ai/brightside</url>
	</scm>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Covia venue runtime. Snapshots are not published to Central: build
		     Convex then Covia locally (mvn install) before building Brightside. -->
		<covia.version>0.10.0-SNAPSHOT</covia.version>
		<flatlaf.version>3.7.2</flatlaf.version>
		<junit.version>6.1.3</junit.version>

		<main.class>covia.brightside.BrightSide</main.class>
	</properties>

	<dependencies>
		<!-- The embedded venue: Engine, VenueServer, LocalVenue and every
		     built-in adapter. Pulls in Convex, Javalin, LangChain4j, MCP, A2A. -->
		<dependency>
			<groupId>ai.covia</groupId>
			<artifactId>venue</artifactId>
			<version>${covia.version}</version>
		</dependency>

		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.7</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[21,)</version>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<!-- Tests boot real venue engines; keep the desktop out of it. -->
					<argLine>-Djava.awt.headless=true</argLine>
				</configuration>
			</plugin>

			<!-- Runnable fat jar at target/brightside.jar. Shade (rather than the
			     assembly plugin) so that META-INF/services entries from Jetty,
			     Javalin, LangChain4j and friends are merged instead of clobbered. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.build.directory}/brightside.jar</outputFile>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<filters>
								<!-- Every jar built with the javalin-openapi annotation
								     processor carries its OpenAPI document at the same
								     resource path. Drop convex-restapi's copy so the
								     venue's own document is served at /openapi (the same
								     fix covia.jar applies in its assembly descriptor). -->
								<filter>
									<artifact>world.convex:convex-restapi</artifact>
									<excludes>
										<exclude>openapi-plugin/**</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${main.class}</mainClass>
									<manifestEntries>
										<Multi-Release>true</Multi-Release>
										<!-- FlatLaf loads a native helper library; without this Java 22+
										     warns on every launch and will eventually refuse. -->
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
										<Implementation-Title>${project.name}</Implementation-Title>
										<Implementation-Version>${project.version}</Implementation-Version>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Developer convenience: mvn exec:java -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<mainClass>${main.class}</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
